# netmcp environment variables. Copy to .env (read by `docker compose`) or set
# them in your MCP client config. A .env is optional: nodes without a variable
# use the NOS default password (SR OS NokiaSros1!, SR Linux NokiaSrl1!,
# EOS/Junos/IOS XR admin).

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Per-node password: NETMCP_<NODE>_PASSWORD, node name uppercased, "-" → "_".
# Takes precedence over all other password variables.
# NETMCP_PTX_PASSWORD=admin@123
# NETMCP_PTX_GW_PASSWORD=admin@123

# Password for any node without a per-node variable.
# NETMCP_DEFAULT_PASSWORD=

# Legacy alias for SR OS nodes, used if neither of the above is set.
# SROS_PASSWORD=

# ---------------------------------------------------------------------------
# docker compose
# ---------------------------------------------------------------------------

# Inventory file mounted into the container (default ./netmcp.yml).
# NETMCP_INVENTORY=/path/to/netmcp.yml

# Docker network of the containerlab lab (topology `mgmt.network`, default clab).
# CLAB_NETWORK=clab

# Host port for the HTTP endpoint http://localhost:<port>/mcp (default 8088).
# NETMCP_HTTP_PORT=8088

# ---------------------------------------------------------------------------
# Inventory (running without Docker)
# ---------------------------------------------------------------------------

# Containerlab topology file to read instead of netmcp.yml / containerlab/*.clab.yml.
# NETMCP_CLAB_TOPOLOGY=/path/to/lab.clab.yml

# Start with an empty node list (CI / tests).
# NETMCP_NO_INVENTORY=1
