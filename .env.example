# netmcp environment variables
# Copy relevant lines to your shell profile, .env loader, or .claude/settings.json env block.

# ---------------------------------------------------------------------------
# Credentials
# ---------------------------------------------------------------------------

# Per-node password — replace NODE with the node's short name in uppercase.
# Takes precedence over all other password variables.
# Examples:
NETMCP_DCGW1_PASSWORD=NokiaSros1!
NETMCP_DCGW2_PASSWORD=NokiaSros1!

# Global default password used for any node that doesn't have a per-node variable set.
NETMCP_DEFAULT_PASSWORD=NokiaSros1!

# Legacy alias for SR OS nodes. Recognised if neither of the above are set.
# Kept for backward compatibility with the original router-mcp project.
SROS_PASSWORD=NokiaSros1!

# ---------------------------------------------------------------------------
# Inventory / discovery
# ---------------------------------------------------------------------------

# Explicit path to a containerlab topology file.
# Overrides the automatic scan of containerlab/*.clab.yml.
NETMCP_CLAB_TOPOLOGY=/home/user/labs/my-topology.clab.yml

# Set to 1 to start the server with an empty node list (no inventory required).
# Useful in CI pipelines where no lab or inventory file is available.
NETMCP_NO_INVENTORY=1
